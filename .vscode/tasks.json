      "problemMatcher": []
    },
    {
      "label": "Maven: verify (unitarias + integración)",
      "type": "shell",
      "command": "./mvnw verify",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "App: spring-boot:run",
      "type": "shell",
      "command": "./mvnw spring-boot:run",
      "problemMatcher": []
    }
  ]
