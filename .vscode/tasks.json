      "command": "./scripts/local-postgres.sh start",
      "problemMatcher": []
    },
    {
      "label": "DB: detener PostgreSQL local",
      "type": "shell",
      "command": "./scripts/local-postgres.sh stop",
      "problemMatcher": []
    },
    {
      "label": "Maven: tests unitarios",
      "type": "shell",
      "command": "./mvnw test",
