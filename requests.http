### TP3 - Colección de requests (formato .http, compatible con VS Code REST Client / IntelliJ HTTP Client)
### Requiere la app corriendo y PostgreSQL arriba:
###   ./scripts/local-postgres.sh start
###   ./mvnw spring-boot:run

@baseUrl = http://localhost:8080
@email = ana@example.com
@password = password123
@emailOtro = beto@example.com
@passwordOtro = password123


########################################
# ESTADO (público)
########################################

### Éxito - Health check (200 OK)
GET {{baseUrl}}/health


########################################
# PRODUCTOS (público, solo lectura)
########################################

### Éxito - Listar productos (paginado)
GET {{baseUrl}}/api/productos?limit=5&skip=0
Accept: application/json

### Éxito - Obtener un producto por id existente
GET {{baseUrl}}/api/productos/1
Accept: application/json

### Error - Producto inexistente en DummyJSON -> 502 Bad Gateway
GET {{baseUrl}}/api/productos/999999
Accept: application/json


########################################
# AUTENTICACIÓN (público)
########################################

### Éxito - Registrar usuario A (201 Created)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Éxito - Registrar usuario B (201 Created)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "email": "{{emailOtro}}",
  "password": "{{passwordOtro}}"
}

### Error - Registro con email repetido (409 Conflict)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Error - Registro con contraseña corta (400 Bad Request)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "email": "corta@example.com",
  "password": "123"
}

### Éxito - Login usuario A (200 OK, devuelve token)
# @name loginAna
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Éxito - Login usuario B (200 OK, devuelve token)
# @name loginBeto
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{emailOtro}}",
  "password": "{{passwordOtro}}"
}

### Error - Login con contraseña incorrecta (401 Unauthorized)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "incorrecta"
}


########################################
# LISTAS (requieren token)
########################################

### Éxito - Crear lista del usuario A (201 Created)
# @name crearListaA
POST {{baseUrl}}/api/listas
Authorization: Bearer {{loginAna.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Regalos"
}

### Éxito - Crear segunda lista del usuario A, destino para mover favoritos (201 Created)
# @name crearListaB
POST {{baseUrl}}/api/listas
Authorization: Bearer {{loginAna.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Para comprar en oferta"
}

### Éxito - Listar las listas del usuario A (200 OK)
GET {{baseUrl}}/api/listas
Authorization: Bearer {{loginAna.response.body.$.token}}

### Éxito - Obtener una lista propia (200 OK)
GET {{baseUrl}}/api/listas/{{crearListaA.response.body.$.id}}
Authorization: Bearer {{loginAna.response.body.$.token}}

### Error - Sin token (401 Unauthorized)
GET {{baseUrl}}/api/listas

### Error - Lista ajena (403 Forbidden; ejecutar con el token del usuario B)
GET {{baseUrl}}/api/listas/{{crearListaA.response.body.$.id}}
Authorization: Bearer {{loginBeto.response.body.$.token}}

### Error - Lista inexistente (404 Not Found)
GET {{baseUrl}}/api/listas/999999
Authorization: Bearer {{loginAna.response.body.$.token}}

### Error - Crear una lista sin nombre (400 Bad Request)
POST {{baseUrl}}/api/listas
Authorization: Bearer {{loginAna.response.body.$.token}}
Content-Type: application/json

{
  "nombre": ""
}


########################################
# FAVORITOS (requieren token; heredan el dueño de la lista)
########################################

### Éxito - Crear un favorito en una lista propia (201 Created)
# @name crearFavorito
POST {{baseUrl}}/api/favoritos
Authorization: Bearer {{loginAna.response.body.$.token}}
Content-Type: application/json

{
  "productoId": 1,
  "listaId": {{crearListaA.response.body.$.id}},
  "nota": "Regalo para mi hermana"
}

### Error - Crear un favorito en una lista ajena (403 Forbidden)
POST {{baseUrl}}/api/favoritos
Authorization: Bearer {{loginBeto.response.body.$.token}}
Content-Type: application/json

{
  "productoId": 1,
  "listaId": {{crearListaA.response.body.$.id}},
  "nota": "No debería poder"
}

### Error - Crear un favorito sin productoId ni listaId (400 Bad Request)
POST {{baseUrl}}/api/favoritos
Authorization: Bearer {{loginAna.response.body.$.token}}
Content-Type: application/json

{
  "nota": "Faltan productoId y listaId"
}

### Éxito - Listar los favoritos del usuario A (200 OK)
GET {{baseUrl}}/api/favoritos
Authorization: Bearer {{loginAna.response.body.$.token}}

### Éxito - Obtener un favorito propio (200 OK)
GET {{baseUrl}}/api/favoritos/{{crearFavorito.response.body.$.id}}
Authorization: Bearer {{loginAna.response.body.$.token}}

### Éxito - Actualizar un favorito propio (200 OK)
PUT {{baseUrl}}/api/favoritos/{{crearFavorito.response.body.$.id}}
Authorization: Bearer {{loginAna.response.body.$.token}}
Content-Type: application/json

{
  "productoId": 2,
  "listaId": {{crearListaA.response.body.$.id}},
  "nota": "Nota actualizada"
}

### Éxito - Favoritos de una lista propia (200 OK)
GET {{baseUrl}}/api/listas/{{crearListaA.response.body.$.id}}/favoritos
Authorization: Bearer {{loginAna.response.body.$.token}}

### Error - Favoritos de una lista ajena (403 Forbidden)
GET {{baseUrl}}/api/listas/{{crearListaA.response.body.$.id}}/favoritos
Authorization: Bearer {{loginBeto.response.body.$.token}}

### Error - Eliminar una lista que todavía tiene favoritos (409 Conflict)
DELETE {{baseUrl}}/api/listas/{{crearListaA.response.body.$.id}}
Authorization: Bearer {{loginAna.response.body.$.token}}


########################################
# MOVER FAVORITOS ENTRE LISTAS (transaccional, requiere token)
########################################

### Éxito - Mover los favoritos de la lista A a la lista B y borrar A (204 No Content)
# Requiere que la lista A tenga al menos un favorito y que B sea del mismo usuario.
POST {{baseUrl}}/api/listas/{{crearListaA.response.body.$.id}}/mover-favoritos
Authorization: Bearer {{loginAna.response.body.$.token}}
Content-Type: application/json

{
  "listaDestinoId": {{crearListaB.response.body.$.id}}
}

### Error - Mover favoritos desde una lista ajena (403 Forbidden)
POST {{baseUrl}}/api/listas/{{crearListaA.response.body.$.id}}/mover-favoritos
Authorization: Bearer {{loginBeto.response.body.$.token}}
Content-Type: application/json

{
  "listaDestinoId": {{crearListaB.response.body.$.id}}
}


########################################
# ADMINISTRADOR
########################################
# Para probar el rol ADMIN, registrá un usuario y promovelo por SQL:
#   docker compose exec postgres psql -U tp1_user -d tp1_favoritos \
#     -c "UPDATE usuarios SET rol = 'ADMIN' WHERE email = 'admin@example.com';"
# Luego volvé a hacer login para que el JWT incluya el rol ADMIN.
# Un ADMIN puede ver y operar sobre listas de cualquier usuario (200 en vez de 403).
